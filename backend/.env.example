APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/aadi_crm
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_BASE_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
FORGOT_PASSWORD_RATE_LIMIT=5
FORGOT_PASSWORD_RATE_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
RESET_PASSWORD_RATE_LIMIT=10
RESET_PASSWORD_RATE_WINDOW_SECONDS=900

EMAIL_BACKEND=file
EMAIL_OUTBOX_DIR=var/outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost
SMTP_USE_TLS=true
